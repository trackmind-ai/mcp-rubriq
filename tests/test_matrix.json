{
  "_comment": "Data-driven test matrix, consumed by tests/run_test_matrix.py. Commands are relative to the repo root (the runner's cwd). Expectations for failure-mode cases are EMPIRICAL — set from observed behavior, with notes explaining why that behavior is correct.",
  "cases": [
    {
      "id": "TM-001",
      "category": "custom-stdio-baseline",
      "description": "Minimal well-formed server — regression baseline.",
      "transport": "stdio",
      "command": "python tests/fixtures/sample_server.py",
      "timeout": 15,
      "subprocess_timeout": 30,
      "expect_outcome": "success",
      "assertions": [
        {
          "path": "server_annotations.tool_count",
          "eq": 3
        },
        {
          "path": "resources.0.uri",
          "eq": "file:///workspace",
          "note": "resource content reaches the judge."
        },
        {
          "path": "prompts.0.name",
          "eq": "summarize",
          "note": "prompt content reaches the judge."
        },
        {
          "path": "introspection_warnings",
          "eq": [],
          "note": "A clean run must report zero introspection warnings."
        }
      ],
      "skip_reason": null
    },
    {
      "id": "TM-002",
      "category": "custom-stdio-schema-edge-cases",
      "description": "Tools using $ref/$defs, allOf, oneOf, and outputSchema — probes _map_tool's flat-schema assumption.",
      "transport": "stdio",
      "command": "python tests/fixtures/schema_edge_cases_server.py",
      "timeout": 15,
      "subprocess_timeout": 30,
      "expect_outcome": "success",
      "assertions": [
        {
          "path": "server_annotations.tool_count",
          "eq": 4
        },
        {
          "path": "tools.0.annotations.schema_empty",
          "eq": false,
          "note": "G1 — $ref/$defs schema resolves to its real properties."
        },
        {
          "path": "tools.1.annotations.schema_empty",
          "eq": false,
          "note": "G1 — allOf branches merge."
        },
        {
          "path": "tools.2.annotations.schema_empty",
          "eq": false,
          "note": "G1 — oneOf union flattens."
        },
        {
          "path": "tools.2.annotations.schema_is_union",
          "eq": true
        },
        {
          "path": "tools.3.annotations.schema_empty",
          "eq": false
        },
        {
          "path": "tools.3.output_schema.properties.count.type",
          "eq": "integer",
          "note": "G3 — outputSchema not dropped."
        },
        {
          "path": "tools.0.input_schema.properties.filters.type",
          "eq": "object",
          "note": "G10 — property-level $ref resolved."
        },
        {
          "path": "tools.0.annotations.properties.filters.type_missing",
          "eq": false
        },
        {
          "path": "tools.0.annotations.properties.filters.description_missing",
          "eq": true,
          "note": "Genuine finding, not a false positive."
        }
      ],
      "skip_reason": null
    },
    {
      "id": "TM-003",
      "category": "custom-stdio-resource-templates",
